# Backend Environment
# Copy to .env and fill in values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Data paths (relative to backend/)
DATA_DIR=../data/output

# Parallel Workers (local mode)
RAY_NUM_WORKERS=8

# AWS Lambda Configuration
# Set USE_CLOUD_COMPUTE=true to run optimization on AWS Lambda
USE_CLOUD_COMPUTE=false
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=crew-optimizer

